{
  "name": "indian-missile-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "An interactive 3D-globe visualization and citation-backed database of India's missile flight tests.",
  "scripts": {
    "build:data": "tsx scripts/build-data.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:seo": "tsx scripts/check-seo.ts",
    "lint": "eslint . --max-warnings 0",
    "predev": "npm run build:data",
    "dev": "vite",
    "prebuild": "npm run build:data && npm run lint",
    "build": "tsc --noEmit && vite build",
    "postbuild": "npm run check:seo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run check:links && npm test && npm run build"
  },
  "dependencies": {
    "@turf/circle": "^7.1.0",
    "@turf/destination": "^7.1.0",
    "@turf/helpers": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.31.0",
    "three": "^0.169.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^16.5.0",
    "js-yaml": "^4.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.55.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
