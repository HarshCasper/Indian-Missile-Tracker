{
  "name": "indian-missile-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive 3D-globe visualization and citation-backed database of India's missile flight tests.",
  "scripts": {
    "build:data": "tsx scripts/build-data.ts",
    "check:links": "tsx scripts/check-links.ts",
    "predev": "npm run build:data",
    "dev": "vite",
    "prebuild": "npm run build:data && npm run check:links",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@turf/circle": "^7.1.0",
    "@turf/destination": "^7.1.0",
    "@turf/helpers": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.31.0",
    "three": "^0.169.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "js-yaml": "^4.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
